{
  "name": "CGo OpenMap 线路图开放平台",
  "short_name": "CGo OpenMap",
  "description": "轻量、现代化的开源城市轨道交通智能交互线路图平台",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./assets/images/screenshot-1.png",
      "sizes": "6000x4500",
      "type": "image/png",
      "form_factor": "wide",
      "label": "首页地图展示"
    }
  ],
  "shortcuts": [
    {
      "name": "字母检索",
      "short_name": "字母检索",
      "description": "按字母 A-Z 查看入驻城市列表",
      "url": "./index.html?tab=alpha",
      "icons": [
        {
          "src": "./assets/icons/shortcut-sort.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "最近城市",
      "short_name": "最近城市",
      "description": "按距您由近到远查看城市",
      "url": "./index.html?tab=distance",
      "icons": [
        {
          "src": "./assets/icons/shortcut-location.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "最近使用",
      "short_name": "最近使用",
      "description": "查看最近浏览过的城市线路图",
      "url": "./index.html?tab=recent",
      "icons": [
        {
          "src": "./assets/icons/shortcut-time.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}